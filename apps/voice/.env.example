# Copy to .env and fill in. In production these come from Doppler / Railway.

ENV=development

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+8150...

# Supabase (optional in dev — service falls back to in-memory store if absent)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# App URLs
VOICE_API_URL=https://voice.kayo.me
DASHBOARD_URL=https://app.kayo.me

# Sentry (optional)
SENTRY_DSN_VOICE=

# Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Tokyo

# Shared secret with the dashboard for the /calls/start endpoint.
# Must match VOICE_INTERNAL_API_KEY in apps/dashboard/.env.local
INTERNAL_API_KEY=change-me-shared-with-dashboard
