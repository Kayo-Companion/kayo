# Copy to .env.local and fill in. Without these, /api/checkout runs in stub mode
# and bounces to /sign-up/thanks (good for design review).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe subscription Prices, one per tier
STRIPE_PRICE_ID_LIGHT=price_...      # ¥3,980 / month, 100 minutes
STRIPE_PRICE_ID_STANDARD=price_...   # ¥9,800 / month, 400 minutes
STRIPE_PRICE_ID_PREMIUM=price_...    # ¥19,800 / month, 1000 minutes
# 100-minute add-on pack (one-off Payment price)
STRIPE_PRICE_ID_MINUTE_PACK=price_...

# App URL (used as origin in checkout redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public-facing Twilio number Kayo uses for outbound + inbound calls. Same
# value as TWILIO_PHONE_NUMBER in apps/voice/.env. Shown on the dashboard so
# the senior knows what number to dial back from their registered phone.
NEXT_PUBLIC_KAYO_PHONE_NUMBER=+1...

# Voice service (server-side only)
VOICE_API_URL=http://localhost:8000
VOICE_INTERNAL_API_KEY=change-me-shared-with-voice

# Twilio (used for phone-OTP auth via Twilio Verify). Reuse the same Account
# SID + Auth Token as apps/voice. Create the Verify Service in Twilio Console
# → Verify → Services → Create Service, then paste the VAxxx SID below.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...
